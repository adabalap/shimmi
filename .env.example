# ══════════════════════════════════════════════════════════════════════════════
# Shimmi v3.0.3 — .env.example
# Copy to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=6000
HOST=0.0.0.0
APP_TIMEZONE=Asia/Kolkata          # All reminder timestamps use this timezone
DATA_DIR=./data

# ─── WAHA (WhatsApp HTTP API) ─────────────────────────────────────────────────
WAHA_API_URL=http://localhost:3000/api
WAHA_API_KEY=                       # Optional: set if WAHA requires auth
WAHA_SESSION=default
WEBHOOK_SECRET=                     # Optional: HMAC secret for webhook auth

# ─── Bot identity ─────────────────────────────────────────────────────────────
BOT_PERSONA_NAME=Shimmi
BOT_COMMAND_PREFIX=@shimmi,shimmi

# ─── Access control ──────────────────────────────────────────────────────────
# Comma-separated list of WhatsApp JIDs (e.g. 919876543210@c.us or group@g.us)
ALLOWED_GROUP_JIDS=
ALLOW_ALL_CHATS=0
ALLOW_FROMME=0                      # Set to 1 to respond to messages you send
ALLOW_NLP_WITHOUT_PREFIX=1          # 1 = respond to all DM messages without prefix

# ─── Groq LLM ─────────────────────────────────────────────────────────────────
# Free tier limits (tokens/day):
#   llama-3.3-70b-versatile  →   100,000   ← orchestration (reasoning)
#   llama-3.1-8b-instant     →   500,000   ← extraction, verify, format
#   compound-beta-mini       →   500,000   ← live web search only (own quota)
#
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL_POOL=llama-3.3-70b-versatile,llama-3.1-8b-instant
ORCHESTRATOR_MODEL=llama-3.3-70b-versatile
EXTRACTION_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=45
GROQ_MAX_RETRIES=0                  # Keep 0: disable Groq SDK internal retries
GROQ_MAX_INFLIGHT=5

# ─── Google Gemini (secondary LLM provider) ──────────────────────────────────
# STRONGLY RECOMMENDED — extends daily capacity 10× when Groq 70B is near limit.
#
# Free tier limits (tokens/day):
#   gemini-2.0-flash      → 1,000,000   ← orchestration fallback
#   gemini-2.0-flash-lite → 1,000,000   ← extraction fallback
#   Rate limit:  15 RPM,  1,500 RPD (requests/day)
#
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_ORCHESTRATOR_MODEL=gemini-2.0-flash
GEMINI_EXTRACTION_MODEL=gemini-2.0-flash-lite
GEMINI_TIMEOUT=45
# GEMINI_ENABLED=1  ← auto-enabled when GEMINI_API_KEY is set; set to 0 to disable

# ─── Live search ──────────────────────────────────────────────────────────────
LIVE_SEARCH_ENABLED=1
# compound-beta-mini is Groq's web-grounded model — its quota is SEPARATE from
# llama-3.3-70b. It's reserved exclusively for live web search queries.
LIVE_SEARCH_MODEL=compound-beta-mini

# ─── MCP sidecar ─────────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:7000
MCP_TIMEOUT=8

# ─── News (optional) ─────────────────────────────────────────────────────────
# GNews free tier: 100 requests/day. Sign up at https://gnews.io
GNEWS_API_KEY=

# ─── Memory / ChromaDB ───────────────────────────────────────────────────────
CHROMA_ENABLED=1
CHROMA_COLLECTION=shimmi_conversations
CHROMA_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_TOP_K=10
CHROMA_RECENT_K=10

# ─── Memory quality ──────────────────────────────────────────────────────────
FACTS_VERIFICATION=1
FACTS_MIN_CONF=0.85
ALLOW_FREEFORM_MEMORY_KEYS=1

# ─── Agent tuning ────────────────────────────────────────────────────────────
AGENT_MAX_TURNS=4
MESSAGE_DEBOUNCE_MS=800
LLM_MAX_QUEUE_PER_CHAT=3
LLM_QUEUE_WAIT_SEC=20

# ─── Reminders ───────────────────────────────────────────────────────────────
REMINDER_CHECK_INTERVAL_SEC=60

# ─── Debug ───────────────────────────────────────────────────────────────────
DEBUG_AGENT=0                       # Set to 1 to log raw LLM I/O for debugging
TRACE_ENABLED=1
